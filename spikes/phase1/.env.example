# Isolated test database only. Never use production for the database spike.
# Optional: supplied test database must permit creation of an isolated schema.
SPIKE_DATABASE_URL=
SPIKE_ALLOW_EXTERNAL_DATABASE=no
# Neon project with Auth enabled; configure production OAuth separately.
NEON_AUTH_BASE_URL=
# Strong random secret; never use a development example in a deployment.
NEON_AUTH_COOKIE_SECRET=
# Temporary bootstrap inputs for updating the existing development Google provider.
# These are not required by browser code or the hosted application's runtime.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
