{
  "name": "gdgbingo-phase1-spikes",
  "version": "0.0.0",
  "private": true,
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    }
  },
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/astro/bin/astro.mjs dev",
    "build": "astro build",
    "check": "astro check",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:database": "node --env-file-if-exists=.env scripts/database-spike.mjs",
    "verify:build": "node scripts/verify-build.mjs"
  },
  "dependencies": {
    "@astrojs/react": "7.1.0",
    "@astrojs/vercel": "11.0.15",
    "@neondatabase/neon-js": "0.8.0-beta",
    "@neondatabase/serverless": "1.2.0",
    "astro": "7.4.0",
    "drizzle-orm": "0.45.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.22.0"
  },
  "optionalDependencies": {
    "@embedded-postgres/windows-x64": "18.4.0-beta.17"
  },
  "devDependencies": {
    "pg": "8.23.1",
    "@astrojs/check": "0.9.10",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
