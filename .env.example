# Server-only. Use a development branch locally; never prefix these with PUBLIC_.
DATABASE_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# Independent 32-byte hex keys. Retain keys for the lifetime of issued codes.
CODE_DIGEST_KEY=
CODE_ENCRYPTION_KEY=
# Migration safety guard: development or production, selected explicitly.
DATABASE_ENVIRONMENT=development
